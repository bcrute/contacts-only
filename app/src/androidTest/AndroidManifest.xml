<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- These permissions belong only to the independently installed fixture. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <application>
        <provider android:name="com.ben.contactsonly.IntegrationFixtureProvider"
            android:authorities="${applicationId}.fixture"
            android:exported="true" android:permission="android.permission.DUMP"
            android:process=":fixture" />
        <activity android:name="com.ben.contactsonly.IntegrationDialerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <service android:name="com.ben.contactsonly.IntegrationInCallService"
            android:exported="true" android:permission="android.permission.BIND_INCALL_SERVICE"
            android:process=":fixture">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <!-- Profile owner for a synthetic work profile on the disposable emulator. -->
        <receiver android:name="com.ben.contactsonly.IntegrationAdminReceiver"
            android:exported="true" android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin"
                android:resource="@xml/integration_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
